{
  "name": "lucid-zero",
  "version": "1.0.0",
  "description": "Generate Zero schemas from Lucid ORM models",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && npx tsx build.ts && chmod +x dist/cli/index.js",
    "test": "vitest run --typecheck --coverage",
    "check-types": "tsc --noEmit"
  },
  "bin": {
    "lucid-zero": "./dist/cli/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "npm@11.12.1",
  "type": "module",
  "devDependencies": {
    "@adonisjs/lucid": "^22.4.2",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.4"
  }
}